# Example profile — copy to <yourname>.env and customize, then:
#   FINOPS_PROFILE=<yourname> ./finops-drift-weekly.sh

# Azure subscription + tenant this profile targets
export AZ_SUBSCRIPTION="00000000-0000-0000-0000-000000000000"
export AZ_TENANT="00000000-0000-0000-0000-000000000000"

# Tags considered mandatory by your governance policy.
# Used by finops-tag-compliance.sh to score coverage and build a backfill plan.
export FINOPS_REQUIRED_TAGS="env app cost_center owner criticality"

# Known resource groups — anything not in this list gets flagged as "new/untracked"
# by finops-drift-weekly.sh. Leave empty to skip the check.
export FINOPS_KNOWN_RGS="rg-prod-app rg-dev-app rg-shared-networking"

# Monthly budget baseline (USD) — printed in the monthly report and used to
# compute % consumed. Optional.
export FINOPS_BUDGET_TOTAL=10000

# Default lookback window for cost queries (days). Optional; defaults to 30.
export FINOPS_COST_DAYS=30

# Age cutoff for "old" disk snapshots in finops-waste-hunter.sh. Optional; defaults to 90.
export FINOPS_SNAPSHOT_AGE_DAYS=90
